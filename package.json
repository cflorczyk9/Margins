{
  "name": "margins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first raw-source-to-wiki compiler with an LLM operating layer.",
  "scripts": {
    "dev": "python3 -m http.server 5173",
    "test": "node --test",
    "test:browser": "MARGINS_BROWSER_TEST=1 node --test tests/browser/*.test.js",
    "typecheck": "tsc -p . --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "playwright-core": "^1.59.1"
  }
}
